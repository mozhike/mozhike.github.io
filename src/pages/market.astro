---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

const posts = (await getSortedPostsList()).filter(
	(post) => post.data.category === "股市研究",
);

const dateFormat = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	timeZone: "Asia/Shanghai",
});
---

<MainGridLayout title="股市研究" description="A 股市场复盘、市场状态观察与研究进展">
	<div class="card-base p-6 md:p-9 mb-4">
		<div class="text-sm font-bold text-[var(--primary)] mb-2">专栏</div>
		<h1 class="text-3xl md:text-4xl font-bold text-90 mb-3">股市研究</h1>
		<p class="text-75 leading-7 mb-4">
			记录 A 股每天发生了什么、为什么，以及研究框架的进展。只做市场观察与复盘，不写系统开发或技术更新；不展示具体标的、持仓与交易参数，不构成投资建议。
		</p>
		<div class="flex flex-wrap gap-2 text-sm text-75">
			<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)]">每日复盘</span>
			<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)]">市场宽度</span>
			<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)]">风格观察</span>
			<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)]">研究进展</span>
		</div>
	</div>

	<div class="flex flex-col gap-4">
		{posts.map((post) => (
			<a
				href={getPostUrlBySlug(post.slug)}
				class="card-base p-6 md:p-7 group transition hover:border-[var(--primary)]"
			>
				<div class="flex flex-wrap items-center gap-3 text-sm text-75 mb-2">
					<time datetime={post.data.published.toISOString()}>
						{dateFormat.format(post.data.published)}
					</time>
					<span>·</span>
					<span>{post.data.category}</span>
				</div>
				<h2 class="text-2xl font-bold text-90 mb-2 transition group-hover:text-[var(--primary)]">
					{post.data.title}
				</h2>
				<p class="text-75 leading-7 line-clamp-2">
					{post.data.description}
				</p>
				<div class="mt-3 text-sm text-[var(--primary)] font-bold">阅读全文 →</div>
			</a>
		))}
	</div>

	{posts.length === 0 && (
		<div class="card-base p-8 text-75">暂无复盘，等下一个交易日。</div>
	)}
</MainGridLayout>
