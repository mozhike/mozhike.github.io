---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { BlogModule } from "../constants/modules";
import { getSortedPostsList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	module: BlogModule;
}

const { module: mod } = Astro.props;
const posts = (await getSortedPostsList()).filter((post) =>
	mod.matches(post.data.category),
);
const sections = mod.groups
	? mod.groups.map((g) => ({
			key: g.key,
			name: g.name,
			blurb: g.blurb,
			posts: posts.filter((p) => g.matches(p.data.category)),
		}))
	: [{ key: "all", name: "", blurb: "", posts }];

const dateFormat = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	timeZone: "Asia/Shanghai",
});
---

<MainGridLayout title={mod.name} description={mod.blurb}>
	<div class="card-base p-6 md:p-9 mb-4" style={`--module-color:${mod.color}`}>
		<div class="font-term text-sm module-accent mb-2">
			mozhike@blog:~$ cd {mod.path}
		</div>
		<h1 class="text-3xl md:text-4xl font-bold text-90 mb-3">{mod.name}</h1>
		<p class="text-75 leading-7 mb-4">{mod.blurb}</p>
		<div class="flex flex-wrap gap-2 text-sm text-75">
			{mod.chips.map((chip) => (
				<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)]">{chip}</span>
			))}
			<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)] font-term">
				{posts.length} 篇
			</span>
		</div>
	</div>

	{sections.map((sec) => (
		<>
			{sec.name && (
				<div
					class="card-base p-5 md:p-6 mt-2 mb-4 border-l-[3px]"
					style={`--module-color:${mod.color};border-left-color:${mod.color}`}
				>
					<div class="flex flex-wrap items-center gap-3">
						<h2 class="text-xl md:text-2xl font-bold text-90">{sec.name}</h2>
						<span class="px-3 py-1 rounded-full bg-[var(--btn-regular-bg)] text-sm text-75 font-term">
							{sec.posts.length} 篇
						</span>
					</div>
					<p class="text-75 leading-6 mt-2 text-sm">{sec.blurb}</p>
				</div>
			)}
			<div class="flex flex-col gap-4">
				{sec.posts.map((post, i) => (
					<a
						href={getPostUrlBySlug(post.slug)}
						class="card-base p-6 md:p-7 group transition hover:border-[var(--module-color)] border-l-[3px] onload-animation"
						style={`--module-color:${mod.color};border-left-color:${mod.color};animation-delay: calc(var(--content-delay) + ${i * 40}ms)`}
					>
						<div class="flex flex-wrap items-center gap-3 text-sm text-75 mb-2 font-term">
							<time datetime={post.data.published.toISOString()}>
								{dateFormat.format(post.data.published)}
							</time>
							<span class="opacity-40">·</span>
							<span class="module-accent">/{mod.short}</span>
						</div>
						<h2 class="text-2xl font-bold text-90 mb-2 transition group-hover:text-[var(--module-color)]">
							{post.data.title}
						</h2>
						<p class="text-75 leading-7 line-clamp-2">{post.data.description}</p>
						<div class="mt-3 text-sm module-accent font-term">阅读全文 →</div>
					</a>
				))}
			</div>
			{sec.name && sec.posts.length === 0 && (
				<div class="card-base p-8 text-75">这个板块还没有内容。</div>
			)}
		</>
	))}

	{posts.length === 0 && (
		<div class="card-base p-8 text-75">这个栏目还没有内容。</div>
	)}
</MainGridLayout>
